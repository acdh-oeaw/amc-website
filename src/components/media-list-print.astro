---
import { isNonNullable } from "@acdh-oeaw/lib";

import type { MediaListPage } from "@/lib/content/types";

interface Props {
	items: Extract<MediaListPage["lists"][number], { discriminant: "print" }>["value"]["items"];
}

const { items } = Astro.props;
---

<div class="divide-y">
	{
		items.map((item) => {
			return (
				<article class="not-prose py-2">
					<h3 class="font-bold">{item.docsrc}</h3>
					<dl class="flex flex-wrap gap-x-8 gap-y-1 text-sm">
						<div>
							<dt class="text-neutral-600">
								<span class="block text-xs font-medium uppercase tracking-wider">
									Vollständige Bezeichnung
								</span>
								<span class="font-mono text-[0.6rem] text-neutral-400">docsrc_name</span>
							</dt>
							<dd>{item.docsrc_name}</dd>
						</div>
						<div>
							<dt class="text-neutral-600">
								<span class="block text-xs font-medium uppercase tracking-wider">Medientyp</span>
								<span class="font-mono text-[0.6rem] text-neutral-400">mediatype</span>
							</dt>
							<dd>{item.mediatype}</dd>
						</div>
						{item.printtype ? (
							<div>
								<dt class="text-neutral-600">
									<span class="block text-xs font-medium uppercase tracking-wider">Printtyp</span>
									<span class="font-mono text-[0.6rem] text-neutral-400">printtype</span>
								</dt>
								<dd>{item.printtype}</dd>
							</div>
						) : null}
						<div>
							<dt class="text-neutral-600">
								<span class="block text-xs font-medium uppercase tracking-wider">Zeitraum</span>
								<span class="font-mono text-[0.6rem] text-neutral-400">from - to</span>
							</dt>
							<dd>{[item.from, item.to].filter(isNonNullable).join(" - ")}</dd>
						</div>
						<div>
							<dt class="text-neutral-600">
								<span class="block text-xs font-medium uppercase tracking-wider">Region</span>
								<span class="font-mono text-[0.6rem] text-neutral-400">region</span>
							</dt>
							<dd>{item.region}</dd>
						</div>
						{item.province ? (
							<div>
								<dt class="text-neutral-600">
									<span class="block text-xs font-medium uppercase tracking-wider">Bundesland</span>
									<span class="font-mono text-[0.6rem] text-neutral-400">province</span>
								</dt>
								<dd>{item.province}</dd>
							</div>
						) : null}
					</dl>
				</article>
			);
		})
	}
</div>
