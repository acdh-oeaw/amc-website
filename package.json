{
	"name": "@acdh-oeaw/amc-website",
	"private": true,
	"license": "MIT",
	"type": "module",
	"engines": {
		"node": "^26"
	},
	"packageManager": "pnpm@12.23.0",
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "12.23.0",
			"onFail": "download"
		},
		"runtime": {
			"name": "node",
			"version": "^26.0.0",
			"onFail": "download"
		}
	},
	"scripts": {
		"build": "run-s build:site generate:search-index",
		"build:site": "astro build",
		"dev": "astro dev",
		"format:check": "oxfmt --check .",
		"format:fix": "oxfmt --write .",
		"generate:search-index": "pagefind --site ./dist/client/",
		"lint:check": "run-p --continue-on-error \"lint:*:check\"",
		"lint:fix": "run-p --continue-on-error \"lint:*:fix\"",
		"lint:code:check": "oxlint --deny-warnings .",
		"lint:code:fix": "pnpm run lint:code:check --fix",
		"lint:styles:check": "stylelint \"./**/*.@(astro|css)\" --cache --ignore-path ./.gitignore",
		"lint:styles:fix": "pnpm run lint:styles:check --fix",
		"preinstall": "npx only-allow pnpm",
		"prepare": "run-s setup",
		"setup": "is-in-ci || test ! -e .git || lefthook install",
		"start": "astro preview",
		"sync": "astro sync",
		"test": "exit 0",
		"test:e2e": "playwright test",
		"test:e2e:codegen": "playwright codegen",
		"test:e2e:install": "playwright install --with-deps",
		"test:e2e:ui": "playwright test --ui",
		"test:e2e:update-snapshots": "playwright test --update-snapshots",
		"types:check": "astro check",
		"validate": "run-s format:check lint:check types:check test test:e2e"
	},
	"dependencies": {
		"@acdh-oeaw/lib": "^0.3.7",
		"@acdh-oeaw/validate-env": "^0.4.0",
		"@astrojs/mdx": "^8.1.6",
		"@astrojs/node": "^11.1.14",
		"@astrojs/react": "^7.1.9",
		"@astrojs/rss": "^4.0.19",
		"@astrojs/sitemap": "^3.7.6",
		"@floating-ui/dom": "^1.8.0",
		"@fontsource-variable/inter": "^5.3.0",
		"@iconify-json/lucide": "^1.2.158",
		"@keystatic/astro": "^6.0.0",
		"@keystatic/core": "^0.6.10",
		"@mdx-js/mdx": "^3.1.1",
		"@pagefind/default-ui": "^1.6.0",
		"astro": "^7.4.13",
		"astro-icon": "^1.2.0",
		"date-fns": "^4.4.0",
		"estree-util-value-to-estree": "^3.5.0",
		"hast-util-heading-rank": "^3.0.0",
		"hast-util-to-string": "^3.0.1",
		"lucide-react": "^1.78.0",
		"nodemailer": "^10.6.1",
		"pagefind": "^1.6.0",
		"pdfkit": "^0.21.0",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"rehype-mdx-import-media": "^1.4.0",
		"rehype-slug": "^6.0.0",
		"remark-frontmatter": "^5.0.0",
		"remark-gfm": "^4.0.1",
		"remark-mdx-frontmatter": "^6.0.0",
		"remark-smartypants": "^3.0.3",
		"retext-smartypants": "^6.2.0",
		"satori": "^0.63.2",
		"sharp": "^0.35.5",
		"unified": "^11.0.5",
		"unist-util-visit": "^5.2.0",
		"valibot": "^1.5.0",
		"vfile": "^6.0.3",
		"vite": "^8.3.8"
	},
	"devDependencies": {
		"@acdh-oeaw/stylelint-config": "^4.0.0",
		"@acdh-oeaw/tsconfig": "^1.5.1",
		"@astrojs/check": "^0.9.12",
		"@astrojs/compiler-rs": "^0.5.3",
		"@astrojs/ts-plugin": "^1.11.0",
		"@playwright/test": "^1.65.1",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.5",
		"@types/hast": "^3.0.5",
		"@types/mdx": "^2.0.14",
		"@types/node": "^26.6.6",
		"@types/nodemailer": "^8.0.2",
		"@types/pdfkit": "^0.17.7",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"axe-core": "^4.14.1",
		"axe-playwright": "^2.2.2",
		"is-in-ci": "^2.0.0",
		"lefthook": "^2.2.2",
		"npm-run-all2": "^9.1.0",
		"oxfmt": "^0.80.0",
		"oxlint": "^1.95.0",
		"schema-dts": "^2.1.0",
		"stylelint": "^18.1.0",
		"tailwindcss": "^4.3.5",
		"type-fest": "^6.0.3",
		"typescript": "^6.0.3"
	},
	"browserslist": {
		"development": [
			"last 1 chrome version",
			"last 1 firefox version",
			"last 1 safari version"
		],
		"production": [
			">=0.75%",
			"not dead",
			"not op_mini all"
		]
	},
	"stylelint": {
		"extends": "@acdh-oeaw/stylelint-config",
		"rules": {
			"at-rule-prelude-no-invalid": [
				true,
				{
					"ignoreAtRules": [
						"apply"
					]
				}
			]
		}
	},
	"volta": {
		"node": "26.13.1"
	}
}
